<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>UV Guard</title>
</head>


<body>

    <header>
    <h1>☀️ UV Guard</h1>
    </header>

<div class="form-card">
    <p>Check the UV index for your location.</p>

    <%#sends from data to the check UV API using post%>
    <form action="/check-uv" method="POST">

        <%# retrieving the users latitude and longitude to send
        to the API to get back a UV esitmation%>
       <label for="latitude">Latitude:</label>
        <input type="number" id="latitude" name="latitude" step="any" required>

        <label for="longitude">Longitude:</label>
        <input type="number" id="longitude" name="longitude" step="any" required>

        <button type="submit">Check UV</button>


    </form>
</div>

    <%#Checks if uvData exists before running the JavaScript%>
    <% if (uvData) { %>

    <div class="results-card">

        <h2>UV Information</h2>

        <div class="uv-main">
            <p>Current UV Index</p>
            <div class="uv-number"><%= uvData.uv %></div>
            <div class="uv-risk"><%= uvRisk %></div>
        </div>

        <p class="recommendation"><%= sunscreenMessage %></p>

        <div class="uv-details">

            <p>
                <strong>Maximum UV Today:</strong>
                <%= uvData.uv_max %>
            </p>

            <p>
                <strong>Maximum UV Time:</strong>
                <%= formattedMaxUvTime %>
            </p>

            <p>
                <strong>Ozone Level:</strong>
                <%= uvData.ozone %>
            </p>

        </div>

    </div>

<% } %>

</body>
</html>